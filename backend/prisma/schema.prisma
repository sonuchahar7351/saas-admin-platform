generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- AUTH & USERS ----------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  isActive      Boolean   @default(true)
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  createdById   String?   // who created this user (Super Admin, usually)
  createdBy     User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers  User[]    @relation("UserCreatedBy")

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  userPermissions UserPermission[]
  createdCampaigns Campaign[]
  uploadedMedia    Media[]
  eightyGReviews EightyGApplication[]
  fraudReviews FraudFlag[]
 

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ---------- RBAC ----------

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // SUPER_ADMIN, SUB_ADMIN, ADMIN
  description String?
  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid())
  resource String // e.g. "users", "reports", "settings"
  action   String // e.g. "read", "write", "delete"
  roles    RolePermission[]

  userPermissions UserPermission[]

  @@unique([resource, action])
  @@map("permissions")
}



// ------------- user permissions ----------

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedById  String     // which Super Admin granted this
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

// join table: which permissions each role has
// this is what lets Super Admin dynamically assign modules to a Sub Admin
model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ---------- AUDIT ----------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // e.g. "CREATE", "UPDATE", "DELETE"
  resource   String   // e.g. "User", "Report"
  resourceId String?
  metadata   Json?    // flexible details — old/new values, etc. (Postgres JSONB)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

//------------- CUSTOMERS ----------

model Customer {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  isActive      Boolean   @default(true)
  refreshTokens CustomerRefreshToken[]
  donations   Donation[]
  billings Billing[]
  eightyGApplications EightyGApplication[]
  passwordResetTokens PasswordResetToken[]
  recurringDonations RecurringDonation[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("customers")
}

model CustomerRefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@map("customer_refresh_tokens")
}

// ---------- MEDIA ----------

enum MediaCategory {
  CAMPAIGN
  CATEGORY
  PRODUCT
  JOURNEY
  TESTIMONIAL
  GALLERY
}

model Media {
  id            String        @id @default(uuid())
  url           String        // public CDN URL
  key           String        // S3 object key, needed for deletion
  category      MediaCategory
  tags          String[]      @default([])
  uploadedById  String
  uploadedBy    User          @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([category])
  @@map("media")
}

// ---------- CATEGORY & NGO ----------

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  imageId   String?
  isActive  Boolean    @default(true)
  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Ngo {
  id          String     @id @default(uuid())
  name        String
  logoId      String?
  description String?
  website     String?
  email       String?
  phone       String?
  address     String?
  isActive    Boolean    @default(true)
  campaigns   Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ngos")
}

// ------------ Campaign -------------

enum CampaignStatus {
  CREATED
  ACTIVE
  COMPLETED
  DELETED
}

model Campaign {
  id               String         @id @default(uuid())
  title            String
  slug             String         @unique
  ngoId            String
  ngo              Ngo            @relation(fields: [ngoId], references: [id])
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  goalAmount       Int            // paise
  shortDescription String
  cardImageId      String?
  story            Json           // TipTap JSON document
  status           CampaignStatus @default(CREATED)
  expiryDate       DateTime

  donationPresets  Json           // [{ amount: 1000, isDefault: true }, ...]
  tipPresets       Json           // [{ percentage: 7, isDefault: true }, ...]

  raisedAmount      Int @default(0) // paise — incremented on each successful donation, not computed live

  createdById      String
  createdBy        User           @relation(fields: [createdById], references: [id])

  products         Product[]
  journeys         CampaignJourney[]
  testimonials     Testimonial[]
  updates          Update[]
  bannerImageIds   String[] @default([])
  isFeatured           Boolean  @default(false)
  featuredOrder         Int?     // null = not ordered; lower number = higher priority
  featureImageDesktopId String?
  featureImageMobileId  String?
  isAddress             Boolean  @default(false) // whether checkout requires city/state/street
  recurringDonations RecurringDonation[]

  isMorph           Boolean    @default(false)
  parentCampaignId  String?
  parent            Campaign?  @relation("CampaignMorphs", fields: [parentCampaignId], references: [id])
  morphs            Campaign[] @relation("CampaignMorphs")
  donations         Donation[] @relation("DonationCampaign")       // financial owner
  sourcedDonations  Donation[] @relation("DonationSourceCampaign") // tracking — which version was viewed


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([categoryId])
  @@map("campaigns")
}


//-------------------Product-------------

enum ProductType {
  SMALL
  MEDIUM
  MEGA
}

model Product {
  id          String      @id @default(uuid())
  campaignId  String
  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  imageId     String?
  title       String
  description String
  quantity    Int
  priority    Int         @default(0)
  amount      Int
  type        ProductType
  isActive    Boolean     @default(true)
  donationProducts DonationProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

// ------------------ Journey------------

model CampaignJourney {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  imageId     String?
  title       String
  description String
  order       Int      @default(0)

  createdAt DateTime @default(now())

  @@map("campaign_journeys")
}

// ------------Testimonial ---------------

model Testimonial {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  imageId     String?
  name        String
  designation String?
  description String
  isActive    Boolean  @default(true)  

  createdAt DateTime @default(now())

  @@map("testimonials")
}

// ---------------Updates --------------

model Update {
  id         String    @id @default(uuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title      String
  content    Json       // TipTap JSON
  glimpses   Glimpse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("updates")
}

// -------------------Glimps --------------

model Glimpse {
  id       String         @id @default(uuid())
  updateId String
  update   Update         @relation(fields: [updateId], references: [id], onDelete: Cascade)
  order    Int            @default(0)
  images   GlimpseImage[]

  createdAt DateTime @default(now())

  @@map("glimpses")
}

// --------------- Glimps Image--------------

model GlimpseImage {
  id        String  @id @default(uuid())
  glimpseId String
  glimpse   Glimpse @relation(fields: [glimpseId], references: [id], onDelete: Cascade)
  mediaId   String
  order     Int     @default(0)

  @@map("glimpse_images")
}

// ---------- DONATIONS (replaces generic Payment) ----------

enum DonationStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum DonationType {
  AMOUNT
  PRODUCT
}

model Donation {
  id                String         @id @default(uuid())
  campaignId        String
  campaign          Campaign       @relation("DonationCampaign", fields: [campaignId],   references: [id])
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id])

  amount            Int            // paise, excluding tip
  tipAmount         Int            @default(0)
  message           String?
  isAnonymous        Boolean        @default(false)

  razorpayOrderId   String         @unique
  razorpayPaymentId String?
  status            DonationStatus @default(CREATED)
  paymentMetadata   Json?          // raw gateway response, for the detail modal

  billingId    String
  billing      Billing @relation(fields: [billingId], references: [id])
  donationType DonationType @default(AMOUNT)
  products     DonationProduct[]
  receipt      Receipt?
  eightyGApplication EightyGApplication?
  recurringDonationId String?
  recurringDonation    RecurringDonation? @relation(fields: [recurringDonationId], references: [id])
  ipAddress String?
  fraudFlags FraudFlag[]

  sourceCampaignId String
  sourceCampaign   Campaign  @relation("DonationSourceCampaign", fields: [sourceCampaignId],references: [id]  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([customerId])
  @@index([status])
  @@map("donations")
}


//--------------------BILLING----------------------
// Donor/billing identity — separate from Customer, per-donation

model Billing {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  donorName     String
  donorEmail    String
  pincode       String
  city          String?
  state         String?
  streetAddress String?
  donations     Donation[]
  recurringDonations RecurringDonation[]
  createdAt     DateTime @default(now())

  @@map("billing")
}

model DonationProduct {
  id         String   @id @default(uuid())
  donationId String
  donation   Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int      @default(1)
  amount     Int

  @@map("donation_products")
}

model Receipt {
  id         String   @id @default(uuid())
  donationId String   @unique
  donation   Donation @relation(fields: [donationId], references: [id])
  pdfUrl     String
  createdAt  DateTime @default(now())

  @@map("receipts")
}


model PasswordResetToken {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  tokenHash  String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("password_reset_tokens")
}

enum EightyGStatus {
  PENDING
  APPROVED
  REJECTED
}

model EightyGApplication {
  id             String        @id @default(uuid())
  donationId     String        @unique // the actual enforcement of "one application per donation"
  donation       Donation      @relation(fields: [donationId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])

  panNumber      String
  fullName       String
  email          String
  address        String

  status         EightyGStatus @default(PENDING)
  certificateUrl String?
  rejectionReason String?

  reviewedById   String?
  reviewedBy     User?         @relation(fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("eighty_g_applications")
}

// recurrring payment system

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum RecurringStatus {
  CREATED     // subscription created on Razorpay, awaiting customer authorization
  ACTIVE      // authorized, Razorpay is billing on schedule
  PAUSED
  HALTED      // Razorpay stopped after repeated charge failures
  CANCELLED
  COMPLETED   // reached total_count cycles
}

model RecurringPlanCache {
  id             String   @id @default(uuid())
  campaignId     String
  amount         Int
  frequency      RecurringFrequency
  razorpayPlanId String   @unique
  createdAt      DateTime @default(now())

  @@unique([campaignId, amount, frequency]) // reuse an existing Plan for the same combo, don't duplicate
  @@map("recurring_plan_cache")
}

model RecurringDonation {
  id                     String             @id @default(uuid())
  campaignId             String
  campaign               Campaign           @relation(fields: [campaignId], references: [id])
  customerId             String
  customer               Customer           @relation(fields: [customerId], references: [id])
  billingId              String
  billing                Billing            @relation(fields: [billingId], references: [id])

  frequency              RecurringFrequency
  amount                 Int                // paise, per cycle
  tipPercentage          Int                @default(0)
  status                 RecurringStatus    @default(CREATED)

  razorpayPlanId         String
  razorpaySubscriptionId String             @unique

  nextChargeDate DateTime?
  cancelledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  donations   Donation[] // each cycle's actual charge, once it's captured

  @@map("recurring_donations")
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
}

model FraudFlag {
  id         String        @id @default(uuid())
  donationId String
  donation   Donation      @relation(fields: [donationId], references: [id])
  ruleCode   String        // e.g. "VELOCITY", "CARD_TESTING", "AMOUNT_ANOMALY", "IP_FANOUT"
  severity   FraudSeverity
  details    Json          // rule-specific context: counts, window, comparison values — enough for an admin to understand why
  reviewed   Boolean       @default(false)
  reviewedById String?
  reviewedBy   User?       @relation(fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())

  @@index([donationId])
  @@index([severity, reviewed])
  @@map("fraud_flags")
}